# Copy to `.env` at the repo root:  cp .env.example .env
# `loadEnvFiles()` reads, in order: <root>/.env, <root>/.env.local,
# apps/web/.env, apps/web/.env.local. First value set wins.
# Never commit a filled-in copy — .env and .env.local are gitignored.

# ── Redis (BullMQ: document + voice queues) ──────────────────────────────────
# Must be the Redis *protocol* URL. The Upstash REST URL/token pair will not
# work with BullMQ.
REDIS_URL="rediss://default:<password>@<host>.upstash.io:6379"

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Server-only. Used by the worker to read/delete Storage objects and bypass RLS.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Supabase Transaction pooler URL (port 6543). Read by drizzle.config.ts for
# db:generate / db:push / db:studio.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:6543/postgres"

# ── OAuth redirect target ────────────────────────────────────────────────────
# Used by /auth/callback to build the redirect origin. Defaults to
# http://localhost:3000 when unset, so set it in any deployed environment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── AI providers ─────────────────────────────────────────────────────────────
# Embeddings: gemini-embedding-001 @ 1536 dims
GEMINI_API_KEY="<gemini-api-key>"
# Socratic chat, quiz/mindmap generation, and Whisper voice transcription
GROQ_API_KEY="<groq-api-key>"
# Web-search tool used by the tutor
TAVILY_API_KEY="<tavily-api-key>"

# ── Optional ─────────────────────────────────────────────────────────────────
# DOCUMENT_WORKER_CONCURRENCY=5
# VOICE_WORKER_CONCURRENCY=2
# Skip real embedding API calls (tests / offline dev)
# EMBEDDING_MOCK=true

# ── Not read by the application code ─────────────────────────────────────────
# Google OAuth is configured in the Supabase dashboard
# (Authentication → Providers → Google), not through these variables.
# OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET are only needed if you wire up the
# provider via the Supabase CLI / config.toml.
