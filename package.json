{
  "name": "socrati",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web",
    "db:generate": "npm run db:generate -w apps/web",
    "db:push": "npm run db:push -w apps/web",
    "db:studio": "npm run db:studio -w apps/web",
    "eval": "tsx eval/run.ts",
    "eval:check": "tsx eval/check.ts",
    "eval:update-baseline": "tsx eval/update-baseline.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/*.test.ts",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
